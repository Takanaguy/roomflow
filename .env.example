# Copier ce fichier en .env.local et remplir les valeurs. .env.local n'est
# jamais commite (voir .gitignore) : c'est le seul endroit ou les vrais
# secrets doivent vivre.

# --- MongoDB Atlas (free tier) ---
# Cluster > Connect > Drivers > copier la chaine de connexion, remplacer
# <password> par le vrai mot de passe de l'utilisateur DB (pas ton mot de
# passe de compte Atlas), et ajouter le nom de la base a la fin du chemin.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/roomflow

# --- NextAuth / Auth.js ---
# Secret de signature des sessions. Generer avec : openssl rand -base64 32
AUTH_SECRET=

# OPTIONNELLE, POUR LES TESTS UNIQUEMENT. Delai (en secondes) entre deux
# relectures du compte pour une session ouverte : c'est le delai maximal avant
# qu'une session soit coupee apres un changement de mot de passe ou la
# suppression du compte. Vide ou invalide (pas un entier strictement positif) :
# 300 (5 minutes). Mettre par exemple 10 pour tester la revocation sans
# attendre, puis la vider.
SESSION_RECHECK_SECONDS=

# --- Google OAuth ---
# console.cloud.google.com > APIs & Services > Identifiants > Creer des
# identifiants > ID client OAuth > Application web.
# Origine JS autorisee : http://localhost:3000
# URI de redirection autorisee : http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- GitHub OAuth ---
# github.com/settings/developers > New OAuth App.
# Homepage URL : http://localhost:3000
# Authorization callback URL : http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Resend (emails transactionnels, free tier) ---
# resend.com > API Keys > Create API Key
RESEND_API_KEY=

# Expediteur des emails. Tant qu'il n'y a pas de domaine verifie dans Resend,
# garder onboarding@resend.dev (seule adresse autorisee en mode sans domaine).
EMAIL_FROM=RoomFlow <onboarding@resend.dev>

# TEST UNIQUEMENT : si rempli, TOUS les emails partent vers cette adresse (celle
# de ton compte Resend), avec l'objet prefixe "[pour : vrai destinataire]". Sert
# a tester avec les comptes test1@roomflow.test... car Resend sans domaine
# n'envoie qu'a l'adresse du compte. A LAISSER VIDE EN PRODUCTION : sinon plus
# personne ne recoit ses emails. Garde-fou : la variable est IGNOREE en production
# (VERCEL_ENV=production, ou NODE_ENV=production hors Vercel), avec un avertissement
# dans les logs, pour qu'un oubli ne detourne pas les vrais emails.
EMAIL_REDIRECT_TO=

# Adresse publique de l'app, pour construire les liens des emails.
# http://localhost:3000 en local, l'URL Vercel en production (sans / final).
APP_URL=http://localhost:3000

# Secret du Cron Vercel des rappels de taches (utilise a la tache suivante).
# Generer avec : openssl rand -base64 32
CRON_SECRET=

# Suppression AUTOMATIQUE des colocations vides ou inactives (lot 11, cron
# /api/cron/nettoyage, une fois par jour). DESACTIVEE par defaut : seule la
# valeur exacte "true" l'active (pas "TRUE", pas "1"). Tant qu'elle n'est pas
# "true", le cron est en SIMULATION : il avertit et annule normalement mais ne
# supprime rien, il compte et journalise « aurait supprime » avec l'id.
# Pourquoi : sans nom de domaine verifie, Resend n'envoie qu'a l'adresse du
# compte Resend, donc les emails d'avertissement n'atteignent pas les vrais
# utilisateurs et une colocation serait supprimee sans preavis reel. A activer
# seulement une fois un domaine branche.
# Une echeance depassee de plus de 7 jours n'est jamais executee : le cron
# repart pour 30 jours (avec un nouvel avertissement si la colocation est
# inactive).
NETTOYAGE_AUTO_ACTIF=

# GARDE D'ENVOI (independant de cette variable) : le cron n'avertit et ne
# planifie que si un preavis peut REELLEMENT arriver. Le depart du dernier
# membre (/leave) suit la meme regle : sans envoi reel possible, le depart
# reussit mais aucune suppression n'est planifiee.
#  - Production : RESEND_API_KEY et EMAIL_FROM definis, et le domaine de
#    EMAIL_FROM n'est pas resend.dev. Sinon, rien n'est planifie ni envoye.
#  - Hors production (local, previsualisation) : la cle Resend suffit, SAUF si
#    EMAIL_REDIRECT_TO est rempli : un mail redirige arrive dans une boite de
#    test, pas chez les vrais membres, donc ce n'est pas un preavis. Le cron
#    n'avertit alors pas, sauf avec NETTOYAGE_ACCEPTER_ENVOI_REDIRIGE.
#
# TESTS UNIQUEMENT, jamais en production, jamais sur une base qui contient de
# vraies colocations a avertir. Valeur exacte "true" : le cron accepte alors un
# envoi redirige (EMAIL_REDIRECT_TO) comme un preavis, pour tester le cron de
# bout en bout. Ignoree en production, comme EMAIL_REDIRECT_TO.
NETTOYAGE_ACCEPTER_ENVOI_REDIRIGE=

# Administrateurs du site (panneau /admin, destruction manuelle de colocations).
# Liste d'adresses email separees par des virgules (casse et espaces ignores),
# par exemple : toi@exemple.com,autre@exemple.com
# VIDE OU ABSENTE : personne n'est administrateur, /admin et son API repondent
# comme une page inexistante (404).
# Seuls comptent les comptes connectes avec Google ou GitHub, dont le
# fournisseur verifie l'adresse. Un compte cree avec email + mot de passe n'est
# JAMAIS administrateur, meme avec une adresse de la liste : a l'inscription
# l'adresse n'est pas verifiee, n'importe qui pourrait s'inscrire avec celle de
# l'administrateur.
SITE_ADMIN_EMAILS=

# Contournement OPTIONNEL du DNS : si la connexion a Atlas echoue avec "querySrv ECONNREFUSED"
# (reseau dont le DNS refuse les requetes SRV), definir par exemple 1.1.1.1,8.8.8.8.
# A laisser vide ailleurs (production comprise).
MONGODB_DNS_SERVERS=

# --- Compte de demonstration (lot 11, bloc C) ---
# Compte PARTAGE pour que les recruteurs essaient l'application sans s'inscrire,
# avec une colocation d'exemple remplie de fausses donnees, remise a zero chaque
# nuit par le cron /api/cron/nettoyage (ou a la main depuis /admin).
# DEMO_PASSWORD : definir pour activer la demo ; c'est un mot de passe PUBLIC,
# affiche dans le README : ne jamais reutiliser un vrai mot de passe. Absente ou
# plus courte que 8 caracteres : la demo est desactivee, rien n'est cree.
DEMO_PASSWORD=
# DEMO_EMAIL : optionnelle, defaut demo@roomflow.invalid (le TLD .invalid est
# reserve par la RFC 2606 : l'adresse n'est jamais livrable, aucun mail ne part).
DEMO_EMAIL=
